,MAAA,OAAA;AAAA,gBAAA,GAAA,MAAA,GAAA,CAAA,cAAA,uBAAA,UAAA,CAAA;AAAA;cAIfS,YAWM,OAAA,EAXD,OAAM,OAAA,GAAM;AAAA,gBACfA,YAA0E,SAAA,EAAnE,OAAM,kDAA+C,QAAM;AAAA,gBAClEA,YAQEC,YAAA;AAAA,kBAAA,YAPSV,MAAA,QAAA;AAAA,kBAAA,uBAAA,CAAA,WAAAM,MAAA,QAAA,IAAA,SAAQ,QAAA,SAAA;AAAA,kBACjB,MAAK;AAAA,kBACL,aAAY;AAAA,kBACZ,SAAQ;AAAA,kBACR,SAAQ;AAAA,kBACR,gBAAA;AAAA,kBACC,UAAUN,MAAA,OAAA;AAAA,gBAAA,GAAA,MAAA,GAAA,CAAA,cAAA,uBAAA,UAAA,CAAA;AAAA;cAIfS,YAQQE,MAAA;AAAA,gBAPN,MAAK;AAAA,gBACL,OAAM;AAAA,gBACN,OAAA;AAAA,gBACC,SAASX,MAAA,OAAA;AAAA,gBACV,OAAA,EAAA,iBAAA,OAAA,kBAAA,QAAA,eAAA,MAAA;AAAA,cAAA,GAAA;AAAA,iCACD,MAED;AAAA,kBAAAY,gBAFC,SAED;AAAA,gBAAA,CAAA;AAAA;;;;;;;AAGS,YAAAT,mBAAAU,UAAA,EAAA,OAAM,UAAM,MAAA,OAAA,CAAA;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrRenderStyle","_ssrInterpolate","siteName","_unref","_push","_parent","_ssrRenderComponent","_component_v_form","_withCtx","_isRef","_","_scopeId","_createVNode","_component_v_text_field","_component_v_btn","_createTextVNode","_component_v_divider"],"sources":["../../../../../../../pages/admin/login.vue"],"sourcesContent":["<template>\n  <div class=\"login-page\">\n    <div class=\"login-card\">\n      <div class=\"mb-8\">\n        <div class=\"text-h6 font-weight-bold mb-1\" style=\"color: #020617;\">\n          ✂️ {{ siteName }}\n        </div>\n        <p class=\"text-body-2 text-grey-darken-1\">Вход в админку</p>\n      </div>\n\n      <v-alert v-if=\"error\" type=\"error\" variant=\"tonal\" density=\"compact\" class=\"mb-6\">\n        {{ error }}\n      </v-alert>\n\n      <v-form @submit.prevent=\"handleLogin\">\n        <div class=\"mb-4\">\n          <label class=\"text-caption text-grey-darken-1 d-block mb-1\">Email</label>\n          <v-text-field\n            v-model=\"email\"\n            type=\"email\"\n            placeholder=\"Введите email\"\n            variant=\"outlined\"\n            density=\"compact\"\n            hide-details\n            :disabled=\"loading\"\n          />\n        </div>\n\n        <div class=\"mb-6\">\n          <label class=\"text-caption text-grey-darken-1 d-block mb-1\">Пароль</label>\n          <v-text-field\n            v-model=\"password\"\n            type=\"password\"\n            placeholder=\"••••••••\"\n            variant=\"outlined\"\n            density=\"compact\"\n            hide-details\n            :disabled=\"loading\"\n          />\n        </div>\n\n        <v-btn\n          type=\"submit\"\n          color=\"green-darken-3\"\n          block\n          :loading=\"loading\"\n          style=\"border-radius: 8px; text-transform: none; font-weight: 500;\"\n        >\n          Войти\n        </v-btn>\n      </v-form>\n\n      <v-divider class=\"my-6\" />\n\n      <div class=\"text-center\">\n        <p class=\"text-caption text-grey-darken-1\">\n          Забыли пароль? Обратитесь к главному администратору\n        </p>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\ndefinePageMeta({ layout: false })\n\nconst email = ref('')\nconst password = ref('')\nconst loading = ref(false)\nconst error = ref('')\n\nconst handleLogin = async () => {\n  error.value = ''\n  loading.value = true\n\n  try {\n    const response = await $fetch('/api/admin/login', {\n      method: 'POST',\n      body: { email: email.value, password: password.value },\n    })\n\n    if (response.token) {\n      // Сохраняем токен в cookie\n      const cookie = useCookie('admin-token')\n      cookie.value = response.token\n      \n      // Перенаправляем на админку\n      await navigateTo('/admin')\n    }\n  } catch (e: any) {\n    error.value = e.data?.message || 'Ошибка входа. Проверьте email и пароль.'\n  } finally {\n    loading.value = false\n  }\n}\n\nuseSeoMeta({\n  title: 'Вход в админку',\n})\n</script>\n\n<style scoped>\n.login-page {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 100vh;\n  background: linear-gradient(135deg, #F0FDF4 0%, #FFFFFF 100%);\n}\n\n.login-card {\n  width: 100%;\n  max-width: 400px;\n  padding: 40px;\n  background: white;\n  border-radius: 16px;\n  border: 1px solid #E2E8F0;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);\n}\n</style>\n"],"version":3}