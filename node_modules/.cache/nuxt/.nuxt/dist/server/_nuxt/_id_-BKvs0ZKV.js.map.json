r","_component_v_chip"],"sources":["../../../../../../../pages/admin/courses/[id].vue"],"sourcesContent":["<template>\n  <div>\n    <div class=\"d-flex align-center mb-6\">\n      <v-btn\n        icon\n        variant=\"text\"\n        color=\"grey-darken-2\"\n        to=\"/admin/courses\"\n        class=\"mr-3\"\n      >\n        <v-icon size=\"20\">mdi-arrow-left</v-icon>\n      </v-btn>\n      <div>\n        <h1 class=\"text-h4 font-weight-bold mb-1\" style=\"color: #020617;\">\n          Редактирование курса\n        </h1>\n        <p class=\"text-body-2 text-grey-darken-1\">\n          Изменение данных курса\n        </p>\n      </div>\n    </div>\n\n    <v-row>\n      <v-col cols=\"12\" md=\"8\">\n        <v-form @submit.prevent=\"saveCourse\">\n          <div class=\"mb-4\">\n            <label class=\"text-caption text-grey-darken-1 d-block mb-1\">Название</label>\n            <v-text-field\n              v-model=\"form.title\"\n              placeholder=\"Название курса\"\n              variant=\"outlined\"\n              density=\"compact\"\n              hide-details\n              class=\"mb-4\"\n            />\n          </div>\n\n          <div class=\"mb-4\">\n            <label class=\"text-caption text-grey-darken-1 d-block mb-1\">Описание</label>\n            <v-textarea\n              v-model=\"form.description\"\n              placeholder=\"Описание курса\"\n              variant=\"outlined\"\n              density=\"compact\"\n              rows=\"4\"\n              hide-details\n              class=\"mb-4\"\n            />\n          </div>\n\n          <v-row>\n            <v-col cols=\"12\" sm=\"6\">\n              <label class=\"text-caption text-grey-darken-1 d-block mb-1\">Цена (₽)</label>\n              <v-text-field\n                v-model.number=\"form.price\"\n                type=\"number\"\n                placeholder=\"0\"\n                variant=\"outlined\"\n                density=\"compact\"\n                hide-details\n                class=\"mb-4\"\n              />\n            </v-col>\n            <v-col cols=\"12\" sm=\"6\">\n              <label class=\"text-caption text-grey-darken-1 d-block mb-1\">Длительность</label>\n              <v-text-field\n                v-model=\"form.duration\"\n                placeholder=\"2 месяца\"\n                variant=\"outlined\"\n                density=\"compact\"\n                hide-details\n                class=\"mb-4\"\n              />\n            </v-col>\n          </v-row>\n\n          <v-row>\n            <v-col cols=\"12\" sm=\"6\">\n              <label class=\"text-caption text-grey-darken-1 d-block mb-1\">Категория</label>\n              <v-select\n                v-model=\"form.category\"\n                :items=\"categories\"\n                variant=\"outlined\"\n                density=\"compact\"\n                hide-details\n                class=\"mb-4\"\n              />\n            </v-col>\n            <v-col cols=\"12\" sm=\"6\">\n              <label class=\"text-caption text-grey-darken-1 d-block mb-1\">Уроков</label>\n              <v-text-field\n                v-model.number=\"form.lessonsCount\"\n                type=\"number\"\n                placeholder=\"0\"\n                variant=\"outlined\"\n                density=\"compact\"\n                hide-details\n                class=\"mb-4\"\n              />\n            </v-col>\n          </v-row>\n\n          <v-checkbox\n            v-model=\"form.isPublished\"\n            label=\"Опубликовать курс\"\n            hide-details\n            class=\"mb-6\"\n            color=\"green-darken-3\"\n          />\n\n          <div class=\"d-flex ga-2\">\n            <v-btn\n              type=\"submit\"\n              color=\"green-darken-3\"\n              variant=\"flat\"\n              :loading=\"saving\"\n              style=\"border-radius: 8px;\"\n            >\n              Сохранить\n            </v-btn>\n            <v-btn\n              variant=\"text\"\n              color=\"grey-darken-2\"\n              to=\"/admin/courses\"\n            >\n              Отмена\n            </v-btn>\n          </div>\n        </v-form>\n      </v-col>\n\n      <v-col cols=\"12\" md=\"4\">\n        <div class=\"preview-card\">\n          <p class=\"text-caption text-grey-darken-1 font-weight-medium mb-4\">Предпросмотр</p>\n          <div class=\"mb-4\">\n            <p class=\"text-caption text-grey-darken-1\">Название</p>\n            <p class=\"text-body-2 font-weight-medium\" style=\"color: #020617;\">\n              {{ form.title || 'Название курса' }}\n            </p>\n          </div>\n          <div class=\"mb-4\">\n            <p class=\"text-caption text-grey-darken-1\">Цена</p>\n            <p class=\"text-h6 font-weight-bold\" style=\"color: #020617;\">\n              {{ form.price ? `${form.price} ₽` : '0 ₽' }}\n            </p>\n          </div>\n          <div class=\"mb-4\">\n            <p class=\"text-caption text-grey-darken-1\">Категория</p>\n            <v-chip size=\"x-small\" color=\"green-darken-3\" text-color=\"white\" label>\n              {{ form.category || 'Категория' }}\n            </v-chip>\n          </div>\n          <div class=\"mb-4\">\n            <p class=\"text-caption text-grey-darken-1\">Статус</p>\n            <v-chip\n              size=\"x-small\"\n              :color=\"form.isPublished ? 'green-darken-3' : 'grey-lighten-1'\"\n              text-color=\"white\"\n              label\n            >\n              {{ form.isPublished ? 'Опубликован' : 'Черновик' }}\n            </v-chip>\n          </div>\n          <v-divider class=\"my-4\" />\n          <div>\n            <p class=\"text-caption text-grey-darken-1\">Описание</p>\n            <p class=\"text-body-2\">{{ form.description || 'Описание курса' }}</p>\n          </div>\n        </div>\n      </v-col>\n    </v-row>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\ndefinePageMeta({ middleware: 'admin', layout: 'admin' })\n\nconst route = useRoute()\nconst router = useRouter()\nconst courseId = route.params.id\n\nconst categories = ['Базовый', 'Продвинутый', 'Спецкурс']\n\nconst form = reactive({\n  title: 'Технология пошива',\n  description: 'Основы шитья для начинающих. Юбка, брюки, платье.',\n  price: 15000,\n  category: 'Базовый',\n  duration: '2 месяца',\n  lessonsCount: 16,\n  isPublished: true,\n})\n\nconst saving = ref(false)\n\nconst saveCourse = async () => {\n  saving.value = true\n  try {\n    console.log('Сохранение курса:', form)\n    await new Promise(resolve => setTimeout(resolve, 500))\n    await router.push('/admin/courses')\n  } finally {\n    saving.value = false\n  }\n}\n\nuseSeoMeta({\n  title: 'Редактирование курса — Админка',\n})\n</script>\n\n<style scoped>\n.preview-card {\n  border: 1px solid #E2E8F0;\n  border-radius: 12px;\n  padding: 24px;\n}\n\n.ga-2 {\n  gap: 8px;\n}\n</style>\n"],"version":3}