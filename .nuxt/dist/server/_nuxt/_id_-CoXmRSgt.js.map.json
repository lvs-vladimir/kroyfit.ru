;AAAA,0BACR,gBAAA;AAAA,0BACA,OAAM;AAAA,wBAAA,GAAA,MAAA,GAAA,CAAA,cAAA,uBAAA,OAAA,CAAA;AAAA;sBAIVL,YAiBM,OAAA,EAjBD,OAAM,cAAA,GAAa;AAAA,wBACtBA,YAQQQ,MAAA;AAAA,0BAPN,MAAK;AAAA,0BACL,OAAM;AAAA,0BACN,SAAQ;AAAA,0BACP,SAASJ,MAAA,MAAA;AAAA,0BACV,OAAA,EAAA,iBAAA,MAAA;AAAA,wBAAA,GAAA;AAAA,2CACD,MAED;AAAA,4BAAAH,gBAFC,aAED;AAAA,0BAAA,CAAA;AAAA;;wBACAD,YAMQQ,MAAA;AAAA,0BALN,SAAQ;AAAA,0BACR,OAAM;AAAA,0BACN,IAAG;AAAA,wBAAA,GAAA;AAAA,2CACJ,MAED;AAAA,4BAAAP,gBAFC,UAED;AAAA,0BAAA,CAAA;AAAA;;;;;;;;;cAKND,YAoCQc,MAAA;AAAA,gBApCD,MAAK;AAAA,gBAAK,IAAG;AAAA,cAAA,GAAA;AAAA,iCAClB,MAkCM;AAAA,kBAlCNd,YAkCM,OAAA,EAlCD,OAAM,kBAAc;AAAA,oBACvBA,YAAiF,KAAA,EAA9E,OAAM,6DAA0D,YAAU;AAAA,oBAC7EA,YAKM,OAAA,EALD,OAAM,UAAM;AAAA,sBACfA,YAAkD,KAAA,EAA/C,OAAM,qCAAkC,KAAG;AAAA,sBAC9CA,YAEI,KAAA;AAAA,wBAFD,OAAM;AAAA,wBAAiC,OAAA,EAAA,SAAA,UAAA;AAAA,sBAAA,GACrCW,gBAAAP,MAAA,IAAA,EAAK,QAAI,kBAAA,GAAA,CAAA;AAAA,oBAAA,CAAA;AAAA,oBAGhBJ,YAKM,OAAA,EALD,OAAM,OAAA,GAAM;AAAA,sBACfA,YAAoD,KAAA,EAAjD,OAAM,qCAAkC,OAAK;AAAA,sBAChDA,YAEI,KAAA;AAAA,wBAFD,OAAM;AAAA,wBAAc,OAAA,EAAA,SAAA,UAAA;AAAA,sBAAA,GAClBW,gBAAAP,MAAA,IAAA,EAAK,SAAK,mBAAA,GAAA,CAAA;AAAA,oBAAA,CAAA;AAAA,oBAGjBJ,YAaM,OAAA,EAbD,OAAM,OAAA,GAAM;AAAA,sBACfA,YAAoD,KAAA,EAAjD,OAAM,qCAAkC,OAAK;AAAA,sBAChDA,YAUI,KAAA;AAAA,wBAVD,OAAM;AAAA,wBAAc,OAAA,EAAA,SAAA,UAAA;AAAA,sBAAA,GAAA;AAAA,wBAEbI,MAAA,IAAA,EAAK,QAAAQ,UAAA,GADbC,YAOI,KAAA;AAAA,0BAAA,KAAA;AAAA,0BALD,MAAI,oBAAsBT,MAAA,IAAA,EAAK,IAAI;AAAA,0BACpC,QAAO;AAAA,0BACP,OAAM;AAAA,wBAAA,GACP,SACIO,gBAAGP,MAAA,IAAA,EAAK,IAAI,GAAA,GAAA,CAAA,MAAA,CAAA,MAAAQ,UAAA,GAEjBC,YAAiD,QAAA;AAAA,0BAAA,KAAA;AAAA,0BAApC,OAAM;AAAA,wBAAA,GAAsB,GAAC;AAAA,sBAAA,CAAA;AAAA;oBAG9Cb,YAKM,OAAA,EALD,OAAM,OAAA,GAAM;AAAA,sBACfA,YAAiD,KAAA,EAA9C,OAAM,qCAAkC,IAAE;AAAA,sBAC7CA,YAEI,KAAA;AAAA,wBAFD,OAAM;AAAA,wBAAc,OAAA,EAAA,SAAA,UAAA;AAAA,sBAAA,GAAAW,gBAClBP,MAAA,MAAA,CAAM,GAAA,CAAA;AAAA,oBAAA,CAAA;AAAA;;;;;;;;;;;;;;;;;;;;","names":["_push","_parent","_ssrRenderComponent","_component_v_icon","_withCtx","_","_scopeId","_createVNode","_createTextVNode","_ssrRenderStyle","_component_v_form","_unref","courses","_component_v_text_field","_component_v_select","_component_v_btn","_withModifiers","_ssrInterpolate","_toDisplayString","_openBlock","_createBlock","_component_v_col"],"sources":["../../../../pages/admin/users/[id].vue"],"sourcesContent":["<template>\n  <div>\n    <div class=\"d-flex align-center mb-6\">\n      <v-btn\n        icon\n        variant=\"text\"\n        color=\"grey-darken-2\"\n        to=\"/admin/users\"\n        class=\"mr-3\"\n      >\n        <v-icon size=\"20\">mdi-arrow-left</v-icon>\n      </v-btn>\n      <div>\n        <h1 class=\"text-h4 font-weight-bold mb-1\" style=\"color: #020617;\">\n          Редактирование пользователя\n        </h1>\n        <p class=\"text-body-2 text-grey-darken-1\">\n          Изменение данных ученика\n        </p>\n      </div>\n    </div>\n\n    <v-row>\n      <v-col cols=\"12\" md=\"8\">\n        <v-form @submit.prevent=\"saveUser\">\n          <div class=\"mb-4\">\n            <label class=\"text-caption text-grey-darken-1 d-block mb-1\">Имя</label>\n            <v-text-field\n              v-model=\"form.name\"\n              placeholder=\"Имя пользователя\"\n              variant=\"outlined\"\n              density=\"compact\"\n              hide-details\n              class=\"mb-4\"\n            />\n          </div>\n\n          <div class=\"mb-4\">\n            <label class=\"text-caption text-grey-darken-1 d-block mb-1\">Email</label>\n            <v-text-field\n              v-model=\"form.email\"\n              type=\"email\"\n              placeholder=\"email@example.com\"\n              variant=\"outlined\"\n              density=\"compact\"\n              hide-details\n              class=\"mb-4\"\n            />\n          </div>\n\n          <div class=\"mb-4\">\n            <label class=\"text-caption text-grey-darken-1 d-block mb-1\">VK ID</label>\n            <v-text-field\n              v-model=\"form.vkId\"\n              placeholder=\"123456789\"\n              variant=\"outlined\"\n              density=\"compact\"\n              hide-details\n              class=\"mb-4\"\n            />\n          </div>\n\n          <div class=\"mb-4\">\n            <label class=\"text-caption text-grey-darken-1 d-block mb-1\">Аватар URL</label>\n            <v-text-field\n              v-model=\"form.avatar\"\n              placeholder=\"https://...\"\n              variant=\"outlined\"\n              density=\"compact\"\n              hide-details\n              class=\"mb-4\"\n            />\n          </div>\n\n          <div class=\"mb-4\">\n            <label class=\"text-caption text-grey-darken-1 d-block mb-1\">VK ID</label>\n            <v-text-field\n              v-model=\"form.vk\"\n              placeholder=\"123456789\"\n              variant=\"outlined\"\n              density=\"compact\"\n              hide-details\n              class=\"mb-4\"\n            />\n          </div>\n\n          <div class=\"mb-4\">\n            <label class=\"text-caption text-grey-darken-1 d-block mb-1\">Купленные курсы</label>\n            <v-select\n              v-model=\"form.courses\"\n              :items=\"courses\"\n              item-title=\"title\"\n              item-value=\"slug\"\n              multiple\n              chips\n              variant=\"outlined\"\n              density=\"compact\"\n              hide-details\n              class=\"mb-4\"\n            />\n          </div>\n\n          <div class=\"d-flex ga-2\">\n            <v-btn\n              type=\"submit\"\n              color=\"green-darken-3\"\n              variant=\"flat\"\n              :loading=\"saving\"\n              style=\"border-radius: 8px;\"\n            >\n              Сохранить\n            </v-btn>\n            <v-btn\n              variant=\"text\"\n              color=\"grey-darken-2\"\n              to=\"/admin/users\"\n            >\n              Отмена\n            </v-btn>\n          </div>\n        </v-form>\n      </v-col>\n\n      <v-col cols=\"12\" md=\"4\">\n        <div class=\"preview-card\">\n          <p class=\"text-caption text-grey-darken-1 font-weight-medium mb-4\">Информация</p>\n          <div class=\"mb-4\">\n            <p class=\"text-caption text-grey-darken-1\">Имя</p>\n            <p class=\"text-body-2 font-weight-medium\" style=\"color: #020617;\">\n              {{ form.name || 'Имя пользователя' }}\n            </p>\n          </div>\n          <div class=\"mb-4\">\n            <p class=\"text-caption text-grey-darken-1\">Email</p>\n            <p class=\"text-body-2\" style=\"color: #020617;\">\n              {{ form.email || 'email@example.com' }}\n            </p>\n          </div>\n          <div class=\"mb-4\">\n            <p class=\"text-caption text-grey-darken-1\">VK ID</p>\n            <p class=\"text-body-2\" style=\"color: #020617;\">\n              <a\n                v-if=\"form.vkId\"\n                :href=\"`https://vk.com/id${form.vkId}`\"\n                target=\"_blank\"\n                class=\"text-decoration-none\"\n              >\n                VK {{ form.vkId }}\n              </a>\n              <span v-else class=\"text-grey-lighten-1\">—</span>\n            </p>\n          </div>\n          <div class=\"mb-4\">\n            <p class=\"text-caption text-grey-darken-1\">ID</p>\n            <p class=\"text-body-2\" style=\"color: #020617;\">\n              {{ userId }}\n            </p>\n          </div>\n        </div>\n      </v-col>\n    </v-row>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { onMounted } from 'vue'\n\ndefinePageMeta({ middleware: 'admin', layout: 'admin' })\n\nconst route = useRoute()\nconst router = useRouter()\nconst userId = route.params.id\n\nconst loading = ref(true)\nconst saving = ref(false)\n\nconst form = reactive({\n  name: '',\n  email: '',\n  vkId: '',\n  avatar: '',\n})\n\nconst saveUser = async () => {\n  saving.value = true\n  try {\n    console.log('📝 [Frontend] Сохранение пользователя:', form)\n    \n    await $fetch('/api/admin/settings', {\n      method: 'POST',\n      body: {\n        type: 'user-update',\n        data: {\n          id: userId,\n          name: form.name,\n          email: form.email,\n          vkId: form.vkId,\n          avatar: form.avatar,\n        },\n      },\n    })\n    \n    console.log('✅ [Frontend] Пользователь сохранен')\n    await router.push('/admin/users')\n  } catch (e: any) {\n    console.error('❌ [Frontend] Ошибка сохранения:', e)\n    alert('Ошибка: ' + (e.data?.message || 'Не удалось сохранить пользователя'))\n  } finally {\n    saving.value = false\n  }\n}\n\nonMounted(async () => {\n  try {\n    console.log('🔵 [Frontend] Загрузка пользователя:', userId)\n    \n    // Загружаем данные пользователя\n    const userResponse = await $fetch(`/api/users/${userId}`)\n    const userData = userResponse.user\n    \n    form.name = userData.name || ''\n    form.email = userData.email || ''\n    form.vkId = userData.vkId || ''\n    form.avatar = userData.avatar || ''\n    \n    console.log('✅ [Frontend] Данные загружены')\n  } catch (e) {\n    console.error('❌ [Frontend] Ошибка загрузки:', e)\n    alert('Ошибка загрузки пользователя')\n  } finally {\n    loading.value = false\n  }\n})\n\nuseSeoMeta({\n  title: 'Редактирование пользователя — Админка',\n})\n</script>\n\n<style scoped>\n.preview-card {\n  border: 1px solid #E2E8F0;\n  border-radius: 12px;\n  padding: 24px;\n}\n\n.ga-2 {\n  gap: 8px;\n}\n</style>\n"],"version":3}