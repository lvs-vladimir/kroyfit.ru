AA;AAAA;;;;;;;;;;;;8BAMR,CAAA,MAAAS,UAAA,GAAAC,YAEUW,QAAA;AAAA,gCAAA,KAAA;AAAA,gCAFM,MAAK;AAAA,gCAAO,SAAQ;AAAA,gCAAQ,OAAM;AAAA,8BAAA,GAAA;AAAA,iDAAO,MACtB;AAAA,kCAAArB,gBADsB,oCACtB;AAAA,kCAAAF,YAAoC,KAAA,EAAjC,MAAK,eAAY,cAAY;AAAA,gCAAA,CAAA;AAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;","names":["_push","_parent","_","_scopeId","_ssrRenderComponent","_component_v_container","_withCtx","_createVNode","_component_v_icon","_createTextVNode","_ssrRenderStyle","_ssrInterpolate","siteName","_component_v_btn","_toDisplayString","_component_v_spacer","_component_v_main","_unref","_openBlock","_createBlock","_component_v_img","_component_v_divider","_component_v_avatar","_component_v_chip","_component_v_card","_ssrRenderList","_Fragment","_renderList","_component_v_col","_component_v_row","_component_v_alert","_component_v_app_bar"],"sources":["../../../../pages/profile/index.vue"],"sourcesContent":["<template>\n  <v-app>\n    <v-app-bar color=\"white\" elevation=\"0\" class=\"border-b\">\n      <v-container class=\"d-flex align-center\">\n        <v-btn icon to=\"/\" class=\"mr-3\">\n          <v-icon>mdi-arrow-left</v-icon>\n        </v-btn>\n        <div class=\"text-h6 font-weight-bold\" style=\"color: #00DC82;\">\n          ✂️ {{ siteName }}\n        </div>\n        <v-spacer />\n        <v-btn variant=\"text\" @click=\"logout\">Выйти</v-btn>\n      </v-container>\n    </v-app-bar>\n\n    <v-main class=\"bg-grey-lighten-4\">\n      <v-container class=\"py-8\">\n        <v-row>\n          <!-- Профиль -->\n          <v-col cols=\"12\" md=\"4\">\n            <v-card class=\"pa-6\" style=\"border-radius: 12px;\">\n              <div class=\"text-center mb-4\">\n                <v-avatar size=\"100\" color=\"green-darken-3\" class=\"mb-3\">\n                  <v-img v-if=\"user.avatar\" :src=\"user.avatar\" />\n                  <v-icon v-else size=\"50\" color=\"white\">mdi-account</v-icon>\n                </v-avatar>\n                <h2 class=\"text-h5 font-weight-bold mb-1\">{{ user.name }}</h2>\n                <p class=\"text-body-2 text-grey-darken-1\">{{ user.email }}</p>\n                <v-chip v-if=\"user.vkId\" size=\"small\" color=\"blue\" class=\"mt-2\">\n                  <v-icon start size=\"16\">mdi-vk</v-icon>\n                  VK {{ user.vkId }}\n                </v-chip>\n              </div>\n\n              <v-divider class=\"my-4\" />\n\n              <div class=\"mb-3\">\n                <p class=\"text-caption text-grey-darken-1\">Дата регистрации</p>\n                <p class=\"text-body-2 font-weight-medium\">{{ formatDate(user.createdAt) }}</p>\n              </div>\n\n              <div class=\"mb-3\">\n                <p class=\"text-caption text-grey-darken-1\">Куплено курсов</p>\n                <p class=\"text-h6 font-weight-bold\" style=\"color: #00DC82;\">{{ purchases.length }}</p>\n              </div>\n            </v-card>\n          </v-col>\n\n          <!-- Мои курсы -->\n          <v-col cols=\"12\" md=\"8\">\n            <h2 class=\"text-h5 font-weight-bold mb-4\">Мои курсы</h2>\n\n            <v-row v-if=\"purchases.length > 0\">\n              <v-col v-for=\"purchase in purchases\" :key=\"purchase.id\" cols=\"12\" sm=\"6\">\n                <v-card class=\"pa-4\" style=\"border-radius: 12px;\">\n                  <h3 class=\"text-h6 font-weight-bold mb-2\">{{ purchase.courseName }}</h3>\n                  <p class=\"text-body-2 text-grey-darken-1 mb-3\">{{ purchase.courseDescription }}</p>\n                  \n                  <v-chip size=\"small\" :color=\"purchase.status === 'paid' ? 'green-darken-3' : 'grey'\" class=\"mb-3\">\n                    {{ purchase.status === 'paid' ? 'Оплачено' : 'Ожидание оплаты' }}\n                  </v-chip>\n\n                  <v-divider class=\"my-3\" />\n\n                  <div class=\"d-flex align-center justify-space-between\">\n                    <span class=\"text-caption text-grey-darken-1\">{{ formatDate(purchase.createdAt) }}</span>\n                    <v-btn size=\"small\" color=\"green-darken-3\" variant=\"flat\" :disabled=\"purchase.status !== 'paid'\">\n                      Начать обучение\n                    </v-btn>\n                  </div>\n                </v-card>\n              </v-col>\n            </v-row>\n\n            <v-alert v-else type=\"info\" variant=\"tonal\" class=\"mt-4\">\n              У вас пока нет купленных курсов. <a href=\"/#courses\">Выбрать курс</a>\n            </v-alert>\n          </v-col>\n        </v-row>\n      </v-container>\n    </v-main>\n  </v-app>\n</template>\n\n<script setup lang=\"ts\">\nconst user = ref({\n  id: '',\n  name: '',\n  email: '',\n  vkId: '',\n  avatar: '',\n  createdAt: '',\n})\n\nconst purchases = ref([])\nconst loading = ref(true)\n\n// Загрузка данных пользователя\nonMounted(async () => {\n  try {\n    // TODO: Получать реальный userId из сессии\n    const userId = '1'\n    \n    // Загружаем данные пользователя\n    const userData = await $fetch(`/api/users/${userId}`).catch(() => null)\n    if (userData) {\n      user.value = {\n        id: userData.id,\n        name: userData.name,\n        email: userData.email,\n        vkId: userData.vkId || '',\n        avatar: userData.avatar || '',\n        createdAt: userData.createdAt,\n      }\n    }\n    \n    // Загружаем покупки\n    const purchasesData = await $fetch(`/api/user/courses`)\n    if (purchasesData.success) {\n      purchases.value = purchasesData.courses.map(c => ({\n        id: c.id,\n        courseName: c.title,\n        courseDescription: c.description || '',\n        status: 'paid',\n        createdAt: c.createdAt,\n      }))\n    }\n  } catch (e) {\n    console.error('Ошибка загрузки профиля:', e)\n  } finally {\n    loading.value = false\n  }\n})\n\nconst formatDate = (dateString: string) => {\n  if (!dateString) return '—'\n  return new Date(dateString).toLocaleDateString('ru-RU', {\n    year: 'numeric',\n    month: 'long',\n    day: 'numeric',\n  })\n}\n\nconst logout = () => {\n  // TODO: Очистить сессию\n  navigateTo('/')\n}\n\nuseSeoMeta({\n  title: 'Мой профиль',\n})\n</script>\n"],"version":3}